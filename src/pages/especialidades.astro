---
import AdminLayout from '../layouts/AdminLayout.astro';
---

<AdminLayout>
  <div class="space-y-6" x-data="especialidadesPage()" x-init="load()">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold">Especialidades</h1>
        <p class="text-[var(--color-text-muted)] text-sm mt-0.5">Gestión de especialidades médicas</p>
      </div>
      <button
        @click="openCreate()"
        class="inline-flex items-center gap-2 px-4 py-2.5 bg-primary-600 hover:bg-primary-700 text-white text-sm font-medium rounded-xl transition-colors"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        Nueva Especialidad
      </button>
    </div>

    <div class="bg-[var(--color-surface)] rounded-xl border border-[var(--color-border)] p-4">
      <div class="flex flex-col sm:flex-row gap-3">
        <div class="relative flex-1">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-[var(--color-text-muted)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <input
            type="text"
            x-model="search"
            @input.debounce.300ms="load()"
            placeholder="Buscar especialidad..."
            class="w-full pl-10 pr-4 py-2.5 border border-[var(--color-border)] rounded-xl bg-[var(--color-surface)] text-[var(--color-text)] placeholder:text-[var(--color-text-muted)] focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all text-sm"
          />
        </div>
        <select
          x-model="filters.activo"
          @change="load()"
          class="px-4 py-2.5 border border-[var(--color-border)] rounded-xl bg-[var(--color-surface)] text-[var(--color-text)] text-sm focus:outline-none focus:ring-2 focus:ring-primary-500"
        >
          <option value="">Todos</option>
          <option value="1">Activos</option>
          <option value="0">Inactivos</option>
        </select>
      </div>
    </div>

    <div class="bg-[var(--color-surface)] rounded-xl border border-[var(--color-border)] overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-[var(--color-surface-alt)] border-b border-[var(--color-border)]">
            <tr>
              <th class="text-left px-4 py-3 font-medium text-[var(--color-text-muted)]">Nombre</th>
              <th class="text-left px-4 py-3 font-medium text-[var(--color-text-muted)]">Descripción</th>
              <th class="text-left px-4 py-3 font-medium text-[var(--color-text-muted)]">Estado</th>
              <th class="text-right px-4 py-3 font-medium text-[var(--color-text-muted)]">Acciones</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[var(--color-border)]">
            <template x-if="loading">
              <tr>
                <td colspan="4" class="px-4 py-12 text-center">
                  <div class="flex items-center justify-center gap-2 text-[var(--color-text-muted)]">
                    <svg class="animate-spin w-5 h-5" fill="none" viewBox="0 0 24 24">
                      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                    </svg>
                    Cargando...
                  </div>
                </td>
              </tr>
            </template>
            <template x-if="!loading && items.length === 0">
              <tr>
                <td colspan="4" class="px-4 py-12 text-center">
                  <div class="text-[var(--color-text-muted)]">
                    <svg class="w-12 h-12 mx-auto mb-3 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/></svg>
                    <p class="font-medium">No se encontraron especialidades</p>
                    <p class="text-xs mt-1" x-show="search || filters.activo">Intenta ajustar los filtros de búsqueda</p>
                  </div>
                </td>
              </tr>
            </template>
            <template x-for="item in items" :key="item.id">
              <tr class="hover:bg-[var(--color-surface-alt)] transition-colors">
                <td class="px-4 py-3 font-medium" x-text="item.nombre"></td>
                <td class="px-4 py-3 text-[var(--color-text-muted)]" x-text="item.descripcion || '—'"></td>
                <td class="px-4 py-3">
                  <span
                    class="inline-flex text-xs px-2 py-0.5 rounded-full font-medium"
                    :class="item.activo === '1' ? 'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400' : 'bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-400'"
                    x-text="item.activo === '1' ? 'Activo' : 'Inactivo'"
                  ></span>
                </td>
                <td class="px-4 py-3 text-right">
                  <div class="flex items-center justify-end gap-1">
                    <button
                      @click="edit(item)"
                      class="p-1.5 rounded-lg hover:bg-[var(--color-surface-alt)] text-[var(--color-text-muted)] hover:text-primary-600 transition-colors"
                      title="Editar"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                    </button>
                    <button
                      @click="confirmDelete(item.id, item.nombre)"
                      class="p-1.5 rounded-lg hover:bg-[var(--color-surface-alt)] text-[var(--color-text-muted)] hover:text-red-600 transition-colors"
                      title="Eliminar"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                    </button>
                  </div>
                </td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>

      <div
        x-show="pagination.totalPages > 1"
        class="flex items-center justify-between px-4 py-3 border-t border-[var(--color-border)]"
      >
        <p class="text-xs text-[var(--color-text-muted)]">
          Mostrando <span x-text="items.length"></span> de <span x-text="pagination.total"></span> resultados
        </p>
        <div class="flex items-center gap-1">
          <button
            @click="goToPage(pagination.page - 1)"
            :disabled="pagination.page <= 1"
            class="px-3 py-1.5 text-sm rounded-lg border border-[var(--color-border)] hover:bg-[var(--color-surface-alt)] disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
          >
            Anterior
          </button>
          <template x-for="p in pageNumbers()" :key="p">
            <button
              @click="goToPage(p)"
              :class="p === pagination.page ? 'bg-primary-600 text-white' : 'border border-[var(--color-border)] hover:bg-[var(--color-surface-alt)]'"
              class="px-3 py-1.5 text-sm rounded-lg transition-colors"
              x-text="p"
            ></button>
          </template>
          <button
            @click="goToPage(pagination.page + 1)"
            :disabled="!pagination.hasMore"
            class="px-3 py-1.5 text-sm rounded-lg border border-[var(--color-border)] hover:bg-[var(--color-surface-alt)] disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
          >
            Siguiente
          </button>
        </div>
      </div>
    </div>

    <!-- Create/Edit Modal -->
    <div
      x-show="modal.open"
      class="fixed inset-0 z-50 flex items-center justify-center"
      x-transition.opacity
    >
      <div class="absolute inset-0 bg-black/50" @click="closeModal()"></div>
      <div class="relative bg-[var(--color-surface)] rounded-2xl shadow-xl border border-[var(--color-border)] w-full max-w-lg mx-4 max-h-[90vh] overflow-y-auto" @click.stop>
        <div class="flex items-center justify-between p-5 border-b border-[var(--color-border)]">
          <h2 class="text-lg font-semibold" x-text="editingId ? 'Editar Especialidad' : 'Nueva Especialidad'"></h2>
          <button @click="closeModal()" class="p-1.5 rounded-lg hover:bg-[var(--color-surface-alt)] transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
        <form @submit.prevent="save()" class="p-5 space-y-4">
          <div>
            <label class="block text-sm font-medium mb-1.5 text-[var(--color-text)]">
              Nombre <span class="text-red-500">*</span>
            </label>
            <input
              type="text"
              x-model="formData.nombre"
              required
              class="w-full px-4 py-2.5 border border-[var(--color-border)] rounded-xl bg-[var(--color-surface)] text-[var(--color-text)] placeholder:text-[var(--color-text-muted)] focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all text-sm"
              placeholder="Nombre de la especialidad"
            />
          </div>
          <div>
            <label class="block text-sm font-medium mb-1.5 text-[var(--color-text)]">Descripción</label>
            <textarea
              x-model="formData.descripcion"
              rows="3"
              class="w-full px-4 py-2.5 border border-[var(--color-border)] rounded-xl bg-[var(--color-surface)] text-[var(--color-text)] placeholder:text-[var(--color-text-muted)] focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all text-sm resize-none"
              placeholder="Descripción opcional"
            ></textarea>
          </div>
          <div class="flex items-center gap-2">
            <input
              type="checkbox"
              id="activo"
              x-model="formData.activo"
              true-value="1"
              false-value="0"
              class="w-4 h-4 rounded border-[var(--color-border)] text-primary-600 focus:ring-primary-500"
            />
            <label for="activo" class="text-sm text-[var(--color-text)]">Activo</label>
          </div>
          <div class="flex items-center gap-3 pt-2">
            <button
              type="submit"
              :disabled="saving"
              class="flex-1 py-2.5 bg-primary-600 hover:bg-primary-700 text-white text-sm font-medium rounded-xl transition-colors disabled:opacity-50"
              x-text="saving ? 'Guardando...' : 'Guardar'"
            ></button>
            <button
              type="button"
              @click="closeModal()"
              class="px-4 py-2.5 border border-[var(--color-border)] text-[var(--color-text)] text-sm font-medium rounded-xl hover:bg-[var(--color-surface-alt)] transition-colors"
            >
              Cancelar
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Delete Confirm Modal -->
    <div
      x-show="deleteModal.open"
      class="fixed inset-0 z-50 flex items-center justify-center"
      x-transition.opacity
    >
      <div class="absolute inset-0 bg-black/50" @click="deleteModal.open = false"></div>
      <div class="relative bg-[var(--color-surface)] rounded-2xl shadow-xl border border-[var(--color-border)] w-full max-w-sm mx-4 p-6" @click.stop>
        <div class="text-center">
          <div class="w-12 h-12 bg-red-100 dark:bg-red-900/30 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.34 16.5c-.77.833.192 2.5 1.732 2.5z"/></svg>
          </div>
          <h3 class="text-lg font-semibold mb-1">Confirmar eliminación</h3>
          <p class="text-sm text-[var(--color-text-muted)] mb-6">
            ¿Estás seguro de eliminar <strong x-text="deleteModal.itemName"></strong>? Esta acción no se puede deshacer.
          </p>
          <div class="flex items-center gap-3">
            <button
              @click="deleteModal.open = false"
              class="flex-1 py-2.5 border border-[var(--color-border)] text-[var(--color-text)] text-sm font-medium rounded-xl hover:bg-[var(--color-surface-alt)] transition-colors"
            >
              Cancelar
            </button>
            <button
              @click="doDelete()"
              :disabled="deleting"
              class="flex-1 py-2.5 bg-red-600 hover:bg-red-700 text-white text-sm font-medium rounded-xl transition-colors disabled:opacity-50"
              x-text="deleting ? 'Eliminando...' : 'Eliminar'"
            ></button>
          </div>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<script is:inline>
  window.especialidadesPage = function() {
    return {
      items: [],
      pagination: { total: 0, page: 1, limit: 25, totalPages: 0, hasMore: false },
      loading: true,
      saving: false,
      deleting: false,
      search: '',
      filters: { activo: '' },
      editingId: null,
      modal: { open: false },
      deleteModal: { open: false, itemId: null, itemName: '' },
      formData: {
        nombre: '',
        descripcion: '',
        activo: '1',
      },

      async load() {
        this.loading = true;
        try {
          const params = new URLSearchParams({
            page: String(this.pagination.page),
            limit: String(this.pagination.limit),
            search: this.search,
          });
          if (this.filters.activo) params.set('activo', this.filters.activo);

          const res = await fetch(`/api/especialidades?${params.toString()}`);
          if (!res.ok) throw new Error('Error al cargar');
          const data = await res.json();
          this.items = data.data || [];
          this.pagination = data.pagination || this.pagination;
        } catch (e) {
          window.showToast('Error al cargar lspecialidades', 'error');
        } finally {
          this.loading = false;
        }
      },

      goToPage(page) {
        if (page < 1 || page > this.pagination.totalPages) return;
        this.pagination.page = page;
        this.load();
      },

      pageNumbers() {
        const pages = [];
        const { page, totalPages } = this.pagination;
        const start = Math.max(1, page - 2);
        const end = Math.min(totalPages, page + 2);
        for (let i = start; i <= end; i++) pages.push(i);
        return pages;
      },

      openCreate() {
        this.editingId = null;
        this.formData = { nombre: '', descripcion: '', activo: '1' };
        this.modal.open = true;
      },

      edit(item) {
        this.editingId = item.id;
        this.formData = {
          nombre: item.nombre || '',
          descripcion: item.descripcion || '',
          activo: item.activo || '1',
        };
        this.modal.open = true;
      },

      closeModal() {
        this.modal.open = false;
        this.editingId = null;
        this.formData = { nombre: '', descripcion: '', activo: '1' };
      },

      async save() {
        if (!this.formData.nombre.trim()) {
          window.showToast('El nombre es requerido', 'error');
          return;
        }
        this.saving = true;
        try {
          const url = this.editingId ? `/api/especialidades/${this.editingId}` : '/api/especialidades';
          const method = this.editingId ? 'PUT' : 'POST';
          const res = await fetch(url, {
            method,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(this.formData),
          });
          if (!res.ok) {
            const err = await res.json();
            throw new Error(err.error || 'Error al guardar');
          }
          window.showToast(this.editingId ? 'Especialidad actualizada correctamente' : 'Especialidad creada correctamente');
          this.closeModal();
          this.load();
        } catch (e) {
          window.showToast(err.message || 'Error al guardar', 'error');
        } finally {
          this.saving = false;
        }
      },

      confirmDelete(id, name) {
        this.deleteModal = { open: true, itemId: id, itemName: name };
      },

      async doDelete() {
        if (!this.deleteModal.itemId) return;
        this.deleting = true;
        try {
          const res = await fetch(`/api/especialidades/${this.deleteModal.itemId}`, { method: 'DELETE' });
          if (!res.ok) {
            const err = await res.json();
            throw new Error(err.error || 'Error al eliminar');
          }
          window.showToast('Especialidad eliminada correctamente');
          this.deleteModal.open = false;
          this.load();
        } catch (e) {
          window.showToast(err.message || 'Error al eliminar', 'error');
        } finally {
          this.deleting = false;
        }
      },
    };
  }
</script>
