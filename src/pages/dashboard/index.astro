---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout>
  <div x-data="dashboard()" x-init="load()" class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold">Panel de control</h1>
        <p class="text-[var(--color-text-muted)] text-sm mt-0.5">Resumen operativo — Visitas médicas</p>
      </div>
      <span class="text-xs text-[var(--color-text-muted)]" id="date-text"></span>
    </div>

    <!-- KPIs - Row 1 -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="kpi-card" style="border-top:3px solid #3b82f6">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-lg flex items-center justify-center" style="background:rgba(59,130,246,0.15);color:#3b82f6">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <div>
            <p class="text-xs text-[var(--color-text-muted)] uppercase tracking-wider">Médicos</p>
            <p class="text-2xl font-bold" x-text="data?.counts?.medicos || 0">0</p>
          </div>
        </div>
      </div>
      <div class="kpi-card" style="border-top:3px solid #10b981">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-lg flex items-center justify-center" style="background:rgba(16,185,129,0.15);color:#10b981">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </div>
          <div>
            <p class="text-xs text-[var(--color-text-muted)] uppercase tracking-wider">Visitadores</p>
            <p class="text-2xl font-bold" x-text="data?.counts?.visitadores || 0">0</p>
          </div>
        </div>
      </div>
      <div class="kpi-card" style="border-top:3px solid #f59e0b">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-lg flex items-center justify-center" style="background:rgba(245,158,11,0.15);color:#f59e0b">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
          </div>
          <div>
            <p class="text-xs text-[var(--color-text-muted)] uppercase tracking-wider">Productos</p>
            <p class="text-2xl font-bold" x-text="data?.counts?.productos || 0">0</p>
          </div>
        </div>
      </div>
      <div class="kpi-card" style="border-top:3px solid #ef4444">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-lg flex items-center justify-center" style="background:rgba(239,68,68,0.15);color:#ef4444">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
          </div>
          <div>
            <p class="text-xs text-[var(--color-text-muted)] uppercase tracking-wider">Solic. Pendientes</p>
            <p class="text-2xl font-bold" x-text="data?.counts?.solicitudesPendientes || 0">0</p>
          </div>
        </div>
      </div>
    </div>

    <!-- KPIs - Row 2 -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="kpi-card" style="border-top:3px solid #8b5cf6">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-lg flex items-center justify-center" style="background:rgba(139,92,246,0.15);color:#8b5cf6">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.39-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
          </div>
          <div>
            <p class="text-xs text-[var(--color-text-muted)] uppercase tracking-wider">Especialidades</p>
            <p class="text-2xl font-bold" x-text="data?.counts?.especialidades || 0">0</p>
          </div>
        </div>
      </div>
      <div class="kpi-card" style="border-top:3px solid #06b6d4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-lg flex items-center justify-center" style="background:rgba(6,182,212,0.15);color:#06b6d4">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          </div>
          <div>
            <p class="text-xs text-[var(--color-text-muted)] uppercase tracking-wider">Visitas del Mes</p>
            <p class="text-2xl font-bold" x-text="data?.visitas?.totalMes || 0">0</p>
          </div>
        </div>
      </div>
      <div class="kpi-card" style="border-top:3px solid #10b981">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-lg flex items-center justify-center" style="background:rgba(16,185,129,0.15);color:#10b981">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <div>
            <p class="text-xs text-[var(--color-text-muted)] uppercase tracking-wider">Efectividad</p>
            <p class="text-2xl font-bold" x-text="(data?.visitas?.efectividad || 0) + '%'">0%</p>
            <p class="text-xs" style="color:#10b981" x-text="`${data?.visitas?.efectivasMes || 0} de ${data?.visitas?.totalMes || 0} visitas`"></p>
          </div>
        </div>
      </div>
    </div>

    <!-- Charts Row -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <div class="bg-[var(--color-surface)] rounded-xl border border-[var(--color-border)] p-5">
        <div class="flex items-center justify-between mb-4">
          <h3 class="font-semibold text-sm">Visitas del Mes</h3>
          <span class="text-xs text-[var(--color-text-muted)]" id="month-label"></span>
        </div>
        <div class="h-64">
          <canvas id="lineChart"></canvas>
        </div>
      </div>

      <div class="bg-[var(--color-surface)] rounded-xl border border-[var(--color-border)] p-5">
        <div class="flex items-center justify-between mb-4">
          <h3 class="font-semibold text-sm">Solicitudes (7 días)</h3>
          <span class="badge text-xs px-2 py-0.5 rounded-full" style="background:rgba(245,158,11,0.15);color:#f59e0b;border:1px solid rgba(245,158,11,0.25)" x-text="`${data?.counts?.solicitudesPendientes || 0} pend.`"></span>
        </div>
        <div class="h-64">
          <canvas id="barChart"></canvas>
        </div>
      </div>
    </div>

    <!-- Bottom Row -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <div class="bg-[var(--color-surface)] rounded-xl border border-[var(--color-border)] p-5">
        <h3 class="font-semibold text-sm mb-4">Últimas Solicitudes</h3>
        <template x-if="data?.ultimasSolicitudes?.length">
          <div class="space-y-3">
            <template x-for="s in data.ultimasSolicitudes" :key="s.id">
              <div class="flex items-start gap-3 pb-3 border-b border-[var(--color-border)] last:border-0">
                <div class="w-2 h-2 rounded-full mt-1.5 flex-shrink-0" :style="'background:' + (s.estado === 'pendiente' ? '#f59e0b' : s.estado === 'aprobada' ? '#10b981' : '#ef4444')"></div>
                <div>
                  <p class="text-sm" x-text="s.tipo?.nombre || 'Solicitud'"></p>
                  <p class="text-xs text-[var(--color-text-muted)]" x-text="s.visitador?.nombre || '—'"></p>
                </div>
              </div>
            </template>
          </div>
        </template>
        <template x-if="!data?.ultimasSolicitudes?.length">
          <p class="text-sm text-[var(--color-text-muted)] text-center py-8">Sin solicitudes recientes</p>
        </template>
      </div>

      <div class="bg-[var(--color-surface)] rounded-xl border border-[var(--color-border)] p-5">
        <h3 class="font-semibold text-sm mb-4">Actividad</h3>
        <div class="space-y-3">
          <div class="flex items-start gap-3 pb-3 border-b border-[var(--color-border)]">
            <div class="w-2 h-2 rounded-full mt-1.5 flex-shrink-0" style="background:#10b981"></div>
            <div>
              <p class="text-sm">Dashboard actualizado</p>
              <p class="text-xs text-[var(--color-text-muted)]">Tiempo real</p>
            </div>
          </div>
          <div class="flex items-start gap-3 pb-3 border-b border-[var(--color-border)]">
            <div class="w-2 h-2 rounded-full mt-1.5 flex-shrink-0" style="background:#3b82f6"></div>
            <div>
              <p class="text-sm" x-text="`${data?.counts?.medicos || 0} médicos activos`"></p>
              <p class="text-xs text-[var(--color-text-muted)]">Sincronizado</p>
            </div>
          </div>
          <div class="flex items-start gap-3 pb-3 border-b border-[var(--color-border)]">
            <div class="w-2 h-2 rounded-full mt-1.5 flex-shrink-0" style="background:#f59e0b"></div>
            <div>
              <p class="text-sm" x-text="`${data?.counts?.solicitudesPendientes || 0} solicitudes por revisar`"></p>
              <p class="text-xs text-[var(--color-text-muted)]">Pendientes</p>
            </div>
          </div>
          <div class="flex items-start gap-3 pb-3 border-b border-[var(--color-border)]">
            <div class="w-2 h-2 rounded-full mt-1.5 flex-shrink-0" style="background:#06b6d4"></div>
            <div>
              <p class="text-sm" x-text="`${data?.visitas?.totalMes || 0} visitas este mes`"></p>
              <p class="text-xs text-[var(--color-text-muted)]">Registradas</p>
            </div>
          </div>
        </div>
      </div>

      <div class="bg-[var(--color-surface)] rounded-xl border border-[var(--color-border)] p-5">
        <h3 class="font-semibold text-sm mb-2">Efectividad</h3>
        <p class="text-xs text-[var(--color-text-muted)] mb-4">Visitas concretadas</p>
        <div class="flex flex-col items-center">
          <div class="relative" style="width:140px;height:140px;">
            <canvas id="donutChart"></canvas>
          </div>
          <p class="text-3xl font-bold mt-3" x-text="(data?.visitas?.efectividad || 0) + '%'">0%</p>
          <p class="text-xs text-[var(--color-text-muted)]">Tasa de efectividad</p>
          <div class="flex gap-6 mt-4">
            <div class="flex items-center gap-2">
              <div class="w-3 h-3 rounded-sm" style="background:#10b981"></div>
              <span class="text-xs text-[var(--color-text-muted)]">Efectivas <strong x-text="data?.visitas?.efectivasMes || 0"></strong></span>
            </div>
            <div class="flex items-center gap-2">
              <div class="w-3 h-3 rounded-sm" style="background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.15)"></div>
              <span class="text-xs text-[var(--color-text-muted)]">No efectivas <strong x-text="data?.visitas?.noEfectivasMes || 0"></strong></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script is:inline>
  document.getElementById('date-text').textContent = new Date().toLocaleDateString('es-MX', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
  document.getElementById('month-label').textContent = new Date().toLocaleDateString('es-MX', { year: 'numeric', month: 'long' });

  window.dashboard = function() {
    return {
      data: null,
      async load() {
        try {
          var r = await fetch('/api/dashboard');
          this.data = await r.json();
          this.$nextTick(function() { this.renderCharts(); }.bind(this));
        } catch (e) { /* empty */ }
      },
      renderCharts() {
        if (typeof Chart === 'undefined') return;
        var visitasPorDia = this.data?.charts?.visitasPorDia || [];
        var solicitudesPorDia = this.data?.charts?.solicitudesPorDia || [];
        var g = 'rgba(255,255,255,0.08)';
        var l = 'rgba(255,255,255,0.35)';

        var days = [], totals = [], efects = [];
        for (var i = 0; i < visitasPorDia.length; i++) {
          var d = visitasPorDia[i];
          days.push(String(new Date(d.fecha).getDate()));
          totals.push(Number(d.total));
          efects.push(Number(d.efectivas));
        }

        var c1 = document.getElementById('lineChart');
        if (c1) {
          new Chart(c1, {
            type: 'line',
            data: {
              labels: days,
              datasets: [
                { label: 'Total', data: totals, borderColor: '#3b82f6', backgroundColor: 'rgba(59,130,246,0.08)', borderWidth: 2, fill: true, tension: 0.45, pointRadius: 0, pointHoverRadius: 4 },
                { label: 'Efectivas', data: efects, borderColor: '#10b981', backgroundColor: 'rgba(16,185,129,0.06)', borderWidth: 2, fill: true, tension: 0.45, pointRadius: 0, pointHoverRadius: 4 }
              ]
            },
            options: {
              responsive: true, maintainAspectRatio: false,
              plugins: { legend: { display: false }, tooltip: { backgroundColor: '#1e293b', titleColor: '#fff', bodyColor: 'rgba(255,255,255,0.6)', borderColor: 'rgba(255,255,255,0.08)', borderWidth: 1, padding: 10, cornerRadius: 8 } },
              scales: { x: { grid: { color: g }, ticks: { color: l, font: { size: 10 } } }, y: { grid: { color: g }, ticks: { color: l, font: { size: 10 }, stepSize: 1 } } }
            }
          });
        }

        var solL = [], solD = [];
        for (var j = 0; j < solicitudesPorDia.length; j++) {
          var s = solicitudesPorDia[j];
          solL.push(new Date(s.fecha).toLocaleDateString('es-MX', { weekday: 'short' }));
          solD.push(Number(s.total));
        }

        var c2 = document.getElementById('barChart');
        if (c2) {
          new Chart(c2, {
            type: 'bar',
            data: { labels: solL, datasets: [{ label: 'Solicitudes', data: solD, backgroundColor: solD.map(function(v) { return v > 5 ? 'rgba(239,68,68,0.6)' : 'rgba(59,130,246,0.6)'; }), borderRadius: 5, borderSkipped: false }] },
            options: {
              responsive: true, maintainAspectRatio: false,
              plugins: { legend: { display: false }, tooltip: { backgroundColor: '#1e293b', titleColor: '#fff', bodyColor: 'rgba(255,255,255,0.6)', borderColor: 'rgba(255,255,255,0.08)', borderWidth: 1, padding: 10, cornerRadius: 8 } },
              scales: { x: { grid: { display: false }, ticks: { color: l, font: { size: 11 } } }, y: { grid: { color: g }, ticks: { color: l, font: { size: 10 }, stepSize: 1 } } }
            }
          });
        }

        var c3 = document.getElementById('donutChart');
        if (c3) {
          var ef = this.data?.visitas?.efectividad || 0;
          new Chart(c3, {
            type: 'doughnut',
            data: { datasets: [{ data: [ef, 100 - ef], backgroundColor: ['#10b981', 'rgba(255,255,255,0.06)'], borderWidth: 0 }] },
            options: { responsive: true, maintainAspectRatio: true, cutout: '78%', plugins: { legend: { display: false }, tooltip: { enabled: false } }, animation: { duration: 1200, easing: 'easeInOutQuart' } }
          });
        }
      },
      $nextTick(fn) {
        requestAnimationFrame(function() { requestAnimationFrame(fn); });
      },
    };
  };
</script>

<style>
  .kpi-card { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 0.75rem; padding: 1rem 1.25rem; }
</style>
