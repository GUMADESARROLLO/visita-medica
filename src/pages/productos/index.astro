---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout>
  <div class="space-y-6" x-data="productosPage()" x-init="init()">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold">Productos</h1>
        <p class="text-[var(--color-text-muted)] text-sm mt-0.5">Gestion de productos y sus moleculas</p>
      </div>
      <div class="flex items-center gap-2">
        <button
          @click="viewMode = viewMode === 'table' ? 'card' : 'table'"
          class="p-2 rounded-lg border border-[var(--color-border)] hover:bg-[var(--color-surface-alt)] transition-colors"
          :title="viewMode === 'table' ? 'Ver como tarjetas' : 'Ver como tabla'"
        >
          <svg x-show="viewMode === 'table'" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
          </svg>
          <svg x-show="viewMode === 'card'" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/>
          </svg>
        </button>
        <button
          @click="openModal()"
          class="inline-flex items-center gap-2 px-4 py-2 bg-primary-600 hover:bg-primary-700 text-white text-sm font-medium rounded-xl transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
          Nuevo Producto
        </button>
      </div>
    </div>

    <!-- Search & Filters -->
    <div class="flex flex-col sm:flex-row gap-3">
      <div class="relative flex-1 max-w-sm">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-[var(--color-text-muted)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <input
          type="text"
          x-model="search"
          @input.debounce.300="load()"
          placeholder="Buscar por codigo o nombre..."
          class="w-full pl-10 pr-4 py-2 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500"
        />
      </div>
      <select
        x-model="filtroActivo"
        @change="load()"
        class="px-3 py-2 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500"
      >
        <option value="">Todos los estados</option>
        <option value="1">Activos</option>
        <option value="0">Inactivos</option>
      </select>
      <select
        x-model="filtroMoleculaId"
        @change="load()"
        class="px-3 py-2 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500"
      >
        <option value="">Todas las moleculas</option>
        <template x-for="m in moleculasList" :key="m.id">
          <option :value="m.id" x-text="m.nombre"></option>
        </template>
      </select>
    </div>

    <!-- Table View -->
    <div x-show="viewMode === 'table'" class="bg-[var(--color-surface)] rounded-xl border border-[var(--color-border)] overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="border-b border-[var(--color-border)] bg-[var(--color-surface-alt)]">
              <th class="text-left px-4 py-3 text-xs font-semibold text-[var(--color-text-muted)] uppercase tracking-wider">Imagen</th>
              <th class="text-left px-4 py-3 text-xs font-semibold text-[var(--color-text-muted)] uppercase tracking-wider">Codigo</th>
              <th class="text-left px-4 py-3 text-xs font-semibold text-[var(--color-text-muted)] uppercase tracking-wider">Nombre</th>
              <th class="text-left px-4 py-3 text-xs font-semibold text-[var(--color-text-muted)] uppercase tracking-wider">Molecula</th>
              <th class="text-left px-4 py-3 text-xs font-semibold text-[var(--color-text-muted)] uppercase tracking-wider">Estado</th>
              <th class="text-right px-4 py-3 text-xs font-semibold text-[var(--color-text-muted)] uppercase tracking-wider">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <template x-if="loading">
              <tr>
                <td colspan="6" class="text-center py-12 text-[var(--color-text-muted)]">
                  <div class="flex items-center justify-center gap-2">
                    <svg class="animate-spin w-5 h-5" fill="none" viewBox="0 0 24 24">
                      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                    </svg>
                    Cargando...
                  </div>
                </td>
              </tr>
            </template>
            <template x-if="!loading && items.length === 0">
              <tr>
                <td colspan="6" class="text-center py-12 text-[var(--color-text-muted)]">No se encontraron productos</td>
              </tr>
            </template>
            <template x-for="item in items" :key="item.id">
              <tr class="border-b border-[var(--color-border)] hover:bg-[var(--color-surface-alt)] transition-colors">
                <td class="px-4 py-3">
                  <img x-show="item.imagenUrl" :src="item.imagenUrl" class="w-10 h-10 rounded-lg object-cover border border-[var(--color-border)]" alt="" />
                  <div x-show="!item.imagenUrl" class="w-10 h-10 rounded-lg bg-[var(--color-surface-alt)] border border-[var(--color-border)] flex items-center justify-center">
                    <svg class="w-5 h-5 text-[var(--color-text-muted)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                  </div>
                </td>
                <td class="px-4 py-3 text-sm font-mono" x-text="item.codigo"></td>
                <td class="px-4 py-3 text-sm font-medium" x-text="item.nombre"></td>
                <td class="px-4 py-3 text-sm text-[var(--color-text-muted)]" x-text="item.molecula?.nombre || '—'"></td>
                <td class="px-4 py-3">
                  <span
                    class="inline-flex px-2 py-0.5 text-xs rounded-full font-medium"
                    :class="item.activo === '1' ? 'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400' : 'bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400'"
                    x-text="item.activo === '1' ? 'Activo' : 'Inactivo'"
                  ></span>
                </td>
                <td class="px-4 py-3 text-right">
                  <div class="flex items-center justify-end gap-1">
                    <button
                      @click="openModal(item)"
                      class="p-1.5 rounded-lg hover:bg-[var(--color-surface)] text-[var(--color-text-muted)] hover:text-primary-600 transition-colors"
                      title="Editar"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                      </svg>
                    </button>
                    <button
                      @click="confirmDelete(item)"
                      class="p-1.5 rounded-lg hover:bg-red-50 dark:hover:bg-red-900/20 text-[var(--color-text-muted)] hover:text-red-600 transition-colors"
                      title="Eliminar"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                      </svg>
                    </button>
                  </div>
                </td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      <div class="flex items-center justify-between px-4 py-3 border-t border-[var(--color-border)]">
        <span class="text-sm text-[var(--color-text-muted)]" x-text="`${pagination.total} resultados`"></span>
        <div class="flex items-center gap-1">
          <button
            @click="goToPage(pagination.page - 1)"
            :disabled="pagination.page <= 1"
            class="p-1.5 rounded-lg hover:bg-[var(--color-surface-alt)] disabled:opacity-40 disabled:cursor-not-allowed transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          </button>
          <span class="text-sm px-2" x-text="`Pag. ${pagination.page} / ${pagination.totalPages || 1}`"></span>
          <button
            @click="goToPage(pagination.page + 1)"
            :disabled="!pagination.hasMore"
            class="p-1.5 rounded-lg hover:bg-[var(--color-surface-alt)] disabled:opacity-40 disabled:cursor-not-allowed transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Card View -->
    <div x-show="viewMode === 'card'" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <template x-if="loading">
        <div class="col-span-full text-center py-12 text-[var(--color-text-muted)]">Cargando...</div>
      </template>
      <template x-if="!loading && items.length === 0">
        <div class="col-span-full text-center py-12 text-[var(--color-text-muted)]">No se encontraron productos</div>
      </template>
      <template x-for="item in items" :key="item.id">
        <div class="bg-[var(--color-surface)] rounded-xl border border-[var(--color-border)] overflow-hidden hover:shadow-md transition-shadow">
          <div class="h-40 bg-[var(--color-surface-alt)] overflow-hidden">
            <img x-show="item.imagenUrl" :src="item.imagenUrl" class="w-full h-full object-cover" alt="" />
            <div x-show="!item.imagenUrl" class="w-full h-full flex items-center justify-center">
              <svg class="w-10 h-10 text-[var(--color-text-muted)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            </div>
          </div>
          <div class="p-4">
            <div class="flex items-start justify-between mb-3">
              <div class="flex-1 min-w-0">
                <p class="text-xs font-mono text-[var(--color-text-muted)]" x-text="item.codigo"></p>
                <p class="font-semibold truncate" x-text="item.nombre"></p>
                <p class="text-sm text-[var(--color-text-muted)]" x-text="item.molecula?.nombre || '—'"></p>
              </div>
              <span
                class="flex-shrink-0 px-2 py-0.5 text-xs rounded-full font-medium"
                :class="item.activo === '1' ? 'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400' : 'bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400'"
                x-text="item.activo === '1' ? 'Activo' : 'Inactivo'"
              ></span>
            </div>
            <div class="flex items-center justify-end gap-1 border-t border-[var(--color-border)] pt-3">
            <button
              @click="openModal(item)"
              class="p-1.5 rounded-lg hover:bg-[var(--color-surface-alt)] text-[var(--color-text-muted)] hover:text-primary-600 transition-colors text-xs flex items-center gap-1"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
              Editar
            </button>
            <button
              @click="confirmDelete(item)"
              class="p-1.5 rounded-lg hover:bg-red-50 dark:hover:bg-red-900/20 text-[var(--color-text-muted)] hover:text-red-600 transition-colors text-xs flex items-center gap-1"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
              Eliminar
            </button>
          </div>
        </div>
      </template>
    </div>

    <!-- Modal -->
    <div
      x-show="modalOpen"
      x-transition.opacity
      class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm"
      @click.self="closeModal()"
      @keydown.escape.window="closeModal()"
    >
      <div
        x-show="modalOpen"
        x-transition
        class="bg-[var(--color-surface)] rounded-2xl border border-[var(--color-border)] shadow-2xl w-full max-w-lg max-h-[90vh] overflow-y-auto mx-4"
        @click.stop
      >
        <div class="sticky top-0 bg-[var(--color-surface)] border-b border-[var(--color-border)] px-6 py-4 flex items-center justify-between rounded-t-2xl">
          <h2 class="text-lg font-semibold" x-text="editingId ? 'Editar Producto' : 'Nuevo Producto'"></h2>
          <button
            @click="closeModal()"
            class="p-1.5 rounded-lg hover:bg-[var(--color-surface-alt)] transition-colors"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>

        <form @submit.prevent="save()" class="p-6 space-y-4">
          <div>
            <label class="block text-sm font-medium mb-1.5">Codigo <span class="text-red-500">*</span></label>
            <input
              type="text"
              x-model="form.codigo"
              required
              class="w-full px-3 py-2 bg-[var(--color-surface-alt)] border border-[var(--color-border)] rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500"
              placeholder="Ej: PROD-001"
            />
          </div>

          <div>
            <label class="block text-sm font-medium mb-1.5">Nombre <span class="text-red-500">*</span></label>
            <input
              type="text"
              x-model="form.nombre"
              required
              class="w-full px-3 py-2 bg-[var(--color-surface-alt)] border border-[var(--color-border)] rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500"
              placeholder="Nombre del producto"
            />
          </div>

          <div>
            <label class="block text-sm font-medium mb-1.5">Molecula</label>
            <select
              x-model="form.moleculaId"
              class="w-full px-3 py-2 bg-[var(--color-surface-alt)] border border-[var(--color-border)] rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500"
            >
              <option value="">Seleccionar molecula...</option>
              <template x-for="m in moleculasList" :key="m.id">
                <option :value="m.id" x-text="m.nombre"></option>
              </template>
            </select>
          </div>

          <div>
            <label class="block text-sm font-medium mb-1.5">Descripcion</label>
            <textarea
              x-model="form.descripcion"
              rows="3"
              class="w-full px-3 py-2 bg-[var(--color-surface-alt)] border border-[var(--color-border)] rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 resize-none"
              placeholder="Descripcion del producto..."
            ></textarea>
          </div>

          <div>
            <label class="flex items-center gap-2 cursor-pointer">
              <input
                type="checkbox"
                x-model="form.activo"
                class="w-4 h-4 rounded border-[var(--color-border)] text-primary-600 focus:ring-primary-500"
              />
              <span class="text-sm font-medium">Producto activo</span>
            </label>
          </div>

          <div>
            <label class="block text-sm font-medium mb-1.5">Imagenes</label>
            <div
              class="border-2 border-dashed border-[var(--color-border)] rounded-xl p-6 text-center hover:border-primary-400 transition-colors cursor-pointer"
              @click="$refs.fileInput.click()"
              @dragover.prevent="$el.classList.add('border-primary-500', 'bg-primary-50', 'dark:bg-primary-900/10')"
              @dragleave.prevent="$el.classList.remove('border-primary-500', 'bg-primary-50', 'dark:bg-primary-900/10')"
              @drop.prevent="handleDrop($event); $el.classList.remove('border-primary-500', 'bg-primary-50', 'dark:bg-primary-900/10')"
            >
              <input
                type="file"
                x-ref="fileInput"
                accept="image/*"
                multiple
                class="hidden"
                @change="handleFileSelect($event)"
              />
              <svg class="w-8 h-8 mx-auto mb-2 text-[var(--color-text-muted)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/>
              </svg>
              <p class="text-sm text-[var(--color-text-muted)]">Arrastra imagenes aqui o haz clic para seleccionar</p>
              <p class="text-xs text-[var(--color-text-muted)] mt-1">PNG, JPG, GIF, WebP, SVG - Max 5MB</p>
            </div>

            <!-- Upload progress -->
            <div x-show="uploading" class="mt-3 flex items-center gap-2 text-sm text-[var(--color-text-muted)]">
              <svg class="animate-spin w-4 h-4" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
              </svg>
              Subiendo imagenes...
            </div>

            <!-- Image preview grid -->
            <div x-show="form.imagenes && form.imagenes.length > 0" class="mt-3 grid grid-cols-4 gap-2">
              <template x-for="(img, idx) in form.imagenes" :key="img.id || idx">
                <div class="relative group aspect-square rounded-lg overflow-hidden border border-[var(--color-border)]">
                  <img :src="img.url" class="w-full h-full object-cover" alt="" />
                  <button
                    @click="removeImage(idx)"
                    class="absolute top-1 right-1 p-1 rounded-full bg-red-500 text-white opacity-0 group-hover:opacity-100 transition-opacity"
                    type="button"
                  >
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                  </button>
                </div>
              </template>
            </div>
          </div>

          <div class="flex items-center justify-end gap-3 pt-2 border-t border-[var(--color-border)]">
            <button
              type="button"
              @click="closeModal()"
              class="px-4 py-2 text-sm font-medium border border-[var(--color-border)] rounded-xl hover:bg-[var(--color-surface-alt)] transition-colors"
            >
              Cancelar
            </button>
            <button
              type="submit"
              :disabled="saving"
              class="px-4 py-2 bg-primary-600 hover:bg-primary-700 text-white text-sm font-medium rounded-xl transition-colors disabled:opacity-60 disabled:cursor-not-allowed inline-flex items-center gap-2"
            >
              <svg x-show="saving" class="animate-spin w-4 h-4" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
              </svg>
              <span x-text="editingId ? 'Guardar Cambios' : 'Crear Producto'"></span>
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div
      x-show="deleteModalOpen"
      x-transition.opacity
      class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm"
      @click.self="deleteModalOpen = false"
      @keydown.escape.window="deleteModalOpen = false"
    >
      <div
        x-show="deleteModalOpen"
        x-transition
        class="bg-[var(--color-surface)] rounded-2xl border border-[var(--color-border)] shadow-2xl w-full max-w-sm mx-4 p-6"
        @click.stop
      >
        <div class="text-center">
          <div class="w-12 h-12 mx-auto mb-4 bg-red-100 dark:bg-red-900/30 rounded-full flex items-center justify-center">
            <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.34 16.5c-.77.833.192 2.5 1.732 2.5z"/>
            </svg>
          </div>
          <h3 class="text-lg font-semibold mb-2">Eliminar Producto</h3>
          <p class="text-sm text-[var(--color-text-muted)] mb-6">
            Esta seguro de eliminar <strong x-text="deleteTarget?.nombre"></strong>? Esta accion no se puede deshacer.
          </p>
          <div class="flex items-center justify-center gap-3">
            <button
              @click="deleteModalOpen = false"
              class="px-4 py-2 text-sm font-medium border border-[var(--color-border)] rounded-xl hover:bg-[var(--color-surface-alt)] transition-colors"
            >
              Cancelar
            </button>
            <button
              @click="doDelete()"
              :disabled="deleting"
              class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white text-sm font-medium rounded-xl transition-colors disabled:opacity-60 disabled:cursor-not-allowed inline-flex items-center gap-2"
            >
              <svg x-show="deleting" class="animate-spin w-4 h-4" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
              </svg>
              Eliminar
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<script is:inline>
  window.productosPage = function() {
    return {
      viewMode: 'table',
      search: '',
      filtroActivo: '',
      filtroMoleculaId: '',
      items: [],
      moleculasList: [],
      pagination: { total: 0, page: 1, limit: 25, totalPages: 0, hasMore: false },
      loading: false,
      modalOpen: false,
      editingId: null,
      saving: false,
      uploading: false,
      form: {
        codigo: '',
        nombre: '',
        moleculaId: '',
        descripcion: '',
        activo: true,
        imagenes: [],
      },
      deleteModalOpen: false,
      deleteTarget: null,
      deleting: false,

      async init() {
        await Promise.all([this.loadMoleculas(), this.load()]);
      },

      async loadMoleculas() {
        try {
          const r = await fetch('/api/moleculas?limit=100');
          const d = await r.json();
          this.moleculasList = d.data || [];
        } catch (e) {
          console.error('Error al cargar moleculas:', e);
        }
      },

      async load() {
        this.loading = true;
        try {
          const params = new URLSearchParams();
          params.set('page', String(this.pagination.page));
          params.set('limit', String(this.pagination.limit));
          if (this.search) params.set('search', this.search);
          if (this.filtroActivo) params.set('activo', this.filtroActivo);
          if (this.filtroMoleculaId) params.set('moleculaId', this.filtroMoleculaId);

          const r = await fetch(`/api/productos?${params.toString()}`);
          const d = await r.json();
          this.items = d.data || [];
          this.pagination = d.pagination || { total: 0, page: 1, limit: 25, totalPages: 0, hasMore: false };
        } catch (e) {
          console.error('Error al cargar productos:', e);
          window.showToast('Error al cargar productos', 'error');
        } finally {
          this.loading = false;
        }
      },

      goToPage(page) {
        if (page < 1 || page > this.pagination.totalPages) return;
        this.pagination.page = page;
        this.load();
      },

      async openModal(item) {
        this.editingId = item ? item.id : null;
        if (item) {
          let data = item;
          if (this.editingId) {
            try {
              const r = await fetch(`/api/productos/${this.editingId}`);
              if (r.ok) data = await r.json();
            } catch(e) { /* use list data */ }
          }
          this.form.codigo = data.codigo || '';
          this.form.nombre = data.nombre || '';
          this.form.moleculaId = data.moleculaId || '';
          this.form.descripcion = data.descripcion || '';
          this.form.activo = data.activo === '1';
          this.form.imagenes = (data.imagenes || []).map((img) => ({ id: img.id, url: img.url }));
        } else {
          this.form.codigo = '';
          this.form.nombre = '';
          this.form.moleculaId = '';
          this.form.descripcion = '';
          this.form.activo = true;
          this.form.imagenes = [];
        }
        this.modalOpen = true;
      },

      closeModal() {
        this.modalOpen = false;
        this.editingId = null;
      },

      async save() {
        if (!this.form.codigo.trim() || !this.form.nombre.trim()) {
          window.showToast('Codigo y nombre son requeridos', 'error');
          return;
        }

        this.saving = true;
        try {
          const payload = {
            codigo: this.form.codigo.trim(),
            nombre: this.form.nombre.trim(),
            moleculaId: this.form.moleculaId || '',
            descripcion: this.form.descripcion || '',
            activo: this.form.activo ? '1' : '0',
          };

          const url = this.editingId ? `/api/productos/${this.editingId}` : '/api/productos';
          const method = this.editingId ? 'PUT' : 'POST';

          const r = await fetch(url, {
            method,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });

          if (!r.ok) {
            const err = await r.json();
            throw new Error(err.error || 'Error al guardar');
          }

          const saved = await r.json();
          const productoId = this.editingId || saved.id;

          if (this.form.imagenes.length > 0 && productoId) {
            await this.syncImages(productoId);
          }

          window.showToast(this.editingId ? 'Producto actualizado correctamente' : 'Producto creado correctamente');
          this.closeModal();
          await this.load();
        } catch (e) {
          window.showToast(e.message || 'Error al guardar producto', 'error');
        } finally {
          this.saving = false;
        }
      },

      async syncImages(productoId) {
        const existing = await fetch(`/api/productos/${productoId}`).then(r => r.json());
        const existingUrls = new Set((existing.imagenes || []).map((img) => img.url));
        const currentUrls = new Set(this.form.imagenes.map(img => img.url));

        for (const img of this.form.imagenes) {
          if (!existingUrls.has(img.url)) {
            await fetch('/api/producto-imagenes', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ productoId, url: img.url, orden: 0 }),
            });
          }
        }

        for (const exImg of (existing.imagenes || [])) {
          if (!currentUrls.has(exImg.url)) {
            await fetch(`/api/producto-imagenes/${exImg.id}`, { method: 'DELETE' });
          }
        }
      },

      async handleFileSelect(event) {
        const input = event.target;
        if (!input.files) return;
        await this.uploadFiles(Array.from(input.files));
        input.value = '';
      },

      async handleDrop(event) {
        const files = event.dataTransfer?.files;
        if (!files) return;
        await this.uploadFiles(Array.from(files));
      },

      async uploadFiles(files) {
        this.uploading = true;
        try {
          for (const file of files) {
            if (!file.type.startsWith('image/')) continue;
            if (file.size > 5 * 1024 * 1024) {
              window.showToast(`La imagen ${file.name} excede los 5MB`, 'error');
              continue;
            }

            const formData = new FormData();
            formData.append('file', file);

            const r = await fetch('/api/productos/upload', {
              method: 'POST',
              body: formData,
            });

            if (!r.ok) {
              const err = await r.json();
              throw new Error(err.error || 'Error al subir imagen');
            }

            const { url } = await r.json();
            this.form.imagenes.push({ url });
          }
        } catch (e) {
          window.showToast(e.message || 'Error al subir imagenes', 'error');
        } finally {
          this.uploading = false;
        }
      },

      removeImage(index) {
        this.form.imagenes.splice(index, 1);
      },

      confirmDelete(item) {
        this.deleteTarget = item;
        this.deleteModalOpen = true;
      },

      async doDelete() {
        if (!this.deleteTarget) return;
        this.deleting = true;
        try {
          const r = await fetch(`/api/productos/${this.deleteTarget.id}`, { method: 'DELETE' });
          if (!r.ok) {
            const err = await r.json();
            throw new Error(err.error || 'Error al eliminar');
          }
          window.showToast('Producto eliminado correctamente');
          this.deleteModalOpen = false;
          this.deleteTarget = null;
          await this.load();
        } catch (e) {
          window.showToast(e.message || 'Error al eliminar producto', 'error');
        } finally {
          this.deleting = false;
        }
      },
    };
  }
</script>

<style>
  .toast-enter {
    animation: slideIn 0.3s ease-out;
  }
  .toast-exit {
    animation: slideOut 0.3s ease-in forwards;
  }
  @keyframes slideIn {
    from { transform: translateX(100%); opacity: 0; }
    to { transform: translateX(0); opacity: 1; }
  }
  @keyframes slideOut {
    from { transform: translateX(0); opacity: 1; }
    to { transform: translateX(100%); opacity: 0; }
  }
</style>
