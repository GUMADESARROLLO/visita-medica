---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout>
  <div class="space-y-6" x-data="reportesPage()" x-init="init()">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold">Reportes</h1>
        <p class="text-[var(--color-text-muted)] text-sm mt-0.5">Reporte de visitas médicas</p>
      </div>
    </div>

    <!-- Advanced Filter Panel -->
    <div class="bg-[var(--color-surface)] rounded-xl border border-[var(--color-border)] p-4">
      <div class="flex flex-wrap items-end gap-2">
        <div class="flex-1 min-w-[140px]">
          <label class="block text-[10px] font-medium text-[var(--color-text-muted)] mb-1 uppercase">Rango</label>
          <input type="text" id="dateRange" readonly class="w-full px-3 py-2 border border-[var(--color-border)] rounded-lg bg-[var(--color-surface)] text-xs cursor-pointer" placeholder="Rango..." />
        </div>
        <div class="flex-1 min-w-[120px]">
          <label class="block text-[10px] font-medium text-[var(--color-text-muted)] mb-1 uppercase">Visitador</label>
          <select x-model="filters.visitadorId" class="w-full px-3 py-2 border border-[var(--color-border)] rounded-lg bg-[var(--color-surface)] text-xs">
            <option value="">Todos</option>
            <template x-for="v in visitadoresList" :key="v.id">
              <option :value="v.id" x-text="v.nombre"></option>
            </template>
          </select>
        </div>
        <div class="flex-1 min-w-[120px]">
          <label class="block text-[10px] font-medium text-[var(--color-text-muted)] mb-1 uppercase">Médico</label>
          <select x-model="filters.medicoId" class="w-full px-3 py-2 border border-[var(--color-border)] rounded-lg bg-[var(--color-surface)] text-xs">
            <option value="">Todos</option>
            <template x-for="m in medicosList" :key="m.id">
              <option :value="m.id" x-text="m.nombre"></option>
            </template>
          </select>
        </div>
        <div class="flex-1 min-w-[120px]">
          <label class="block text-[10px] font-medium text-[var(--color-text-muted)] mb-1 uppercase">Especialidad</label>
          <select x-model="filters.especialidadId" class="w-full px-3 py-2 border border-[var(--color-border)] rounded-lg bg-[var(--color-surface)] text-xs">
            <option value="">Todas</option>
            <template x-for="e in especialidadesList" :key="e.id">
              <option :value="e.id" x-text="e.nombre"></option>
            </template>
          </select>
        </div>
        <div class="flex-1 min-w-[90px]">
          <label class="block text-[10px] font-medium text-[var(--color-text-muted)] mb-1 uppercase">Efectiva</label>
          <select x-model="filters.efectiva" class="w-full px-3 py-2 border border-[var(--color-border)] rounded-lg bg-[var(--color-surface)] text-xs">
            <option value="">Todas</option>
            <option value="1">Sí</option>
            <option value="0">No</option>
          </select>
        </div>
        <div>
          <label class="block text-[10px] font-medium text-[var(--color-text-muted)] mb-1 uppercase invisible">_</label>
          <button @click="loadPage(1)" class="px-3 py-2 bg-primary-500 hover:bg-primary-600 text-white rounded-lg text-xs font-medium transition-colors whitespace-nowrap">Aplicar</button>
        </div>
        <div>
          <label class="block text-[10px] font-medium text-[var(--color-text-muted)] mb-1 uppercase invisible">_</label>
          <button @click="exportExcel()" :disabled="exporting" class="px-3 py-2 bg-green-500 hover:bg-green-600 text-white rounded-lg text-xs font-medium transition-colors disabled:opacity-60 whitespace-nowrap" x-text="exporting ? 'Exportando...' : 'Exportar'"></button>
        </div>
        <div>
          <label class="block text-[10px] font-medium text-[var(--color-text-muted)] mb-1 uppercase invisible">_</label>
          <button @click="clearFilters()" class="px-3 py-2 border border-[var(--color-border)] rounded-lg text-xs hover:bg-[var(--color-surface-alt)] transition-colors whitespace-nowrap">Limpiar</button>
        </div>
      </div>
    </div>

    <!-- Summary Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="bg-[var(--color-surface)] rounded-xl border border-[var(--color-border)] p-4">
        <p class="text-xs text-[var(--color-text-muted)]">Total Visitas</p>
        <p class="text-2xl font-bold mt-1" x-text="stats.total">0</p>
      </div>
      <div class="bg-[var(--color-surface)] rounded-xl border border-[var(--color-border)] p-4">
        <p class="text-xs text-[var(--color-text-muted)]">Efectivas</p>
        <p class="text-2xl font-bold mt-1 text-green-600" x-text="stats.efectivas">0</p>
      </div>
      <div class="bg-[var(--color-surface)] rounded-xl border border-[var(--color-border)] p-4">
        <p class="text-xs text-[var(--color-text-muted)]">No Efectivas</p>
        <p class="text-2xl font-bold mt-1 text-red-600" x-text="stats.noEfectivas">0</p>
      </div>
      <div class="bg-[var(--color-surface)] rounded-xl border border-[var(--color-border)] p-4">
        <p class="text-xs text-[var(--color-text-muted)]">Efectividad</p>
        <p class="text-2xl font-bold mt-1 text-primary-600" x-text="stats.efectividad + '%'">0%</p>
        <div class="mt-2 w-full bg-gray-200 dark:bg-gray-700 rounded-full h-1.5">
          <div class="bg-primary-500 h-1.5 rounded-full transition-all" :style="'width:' + (stats.efectividad || 0) + '%'"></div>
        </div>
      </div>
    </div>

    <!-- Table -->
    <div class="bg-[var(--color-surface)] rounded-xl border border-[var(--color-border)] overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-[var(--color-border)] bg-[var(--color-surface-alt)]">
              <th class="text-left px-4 py-3 font-medium text-[var(--color-text-muted)]">Fecha</th>
              <th class="text-left px-4 py-3 font-medium text-[var(--color-text-muted)]">Visitador</th>
              <th class="text-left px-4 py-3 font-medium text-[var(--color-text-muted)]">Médico</th>
              <th class="text-left px-4 py-3 font-medium text-[var(--color-text-muted)]">Especialidad</th>
              <th class="text-left px-4 py-3 font-medium text-[var(--color-text-muted)]">Efectiva</th>
              <th class="text-left px-4 py-3 font-medium text-[var(--color-text-muted)]">Observación</th>
            </tr>
          </thead>
          <tbody>
            <template x-if="loading">
              <tr><td colspan="6" class="text-center py-12 text-[var(--color-text-muted)]">Cargando...</td></tr>
            </template>
            <template x-if="!loading && items.length === 0">
              <tr><td colspan="6" class="text-center py-12 text-[var(--color-text-muted)]">No se encontraron visitas</td></tr>
            </template>
            <template x-for="v in items" :key="v.id">
              <tr class="border-b border-[var(--color-border)] hover:bg-[var(--color-surface-alt)] transition-colors">
                <td class="px-4 py-3 whitespace-nowrap text-xs" x-text="formatDate(v.fecha)"></td>
                <td class="px-4 py-3" x-text="v.visitador?.nombre || '—'"></td>
                <td class="px-4 py-3" x-text="v.medico?.nombre || '—'"></td>
                <td class="px-4 py-3" x-text="v.medico?.especialidad?.nombre || '—'"></td>
                <td class="px-4 py-3">
                  <span class="px-2 py-0.5 rounded-full text-xs font-medium"
                    :class="v.efectiva === '1' ? 'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400' : 'bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400'"
                    x-text="v.efectiva === '1' ? 'Sí' : 'No'"></span>
                </td>
                <td class="px-4 py-3 max-w-xs">
                  <span class="text-xs text-[var(--color-text-muted)] line-clamp-2" x-text="v.observacion || '—'"></span>
                </td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      <template x-if="pagination.totalPages > 1">
        <div class="flex items-center justify-between px-4 py-3 border-t border-[var(--color-border)]">
          <span class="text-sm text-[var(--color-text-muted)]" x-text="`${pagination.total} resultados`"></span>
          <div class="flex items-center gap-1">
            <button @click="loadPage(pagination.page - 1)" :disabled="pagination.page <= 1" class="px-3 py-1.5 text-sm rounded-lg hover:bg-[var(--color-surface-alt)] disabled:opacity-40 disabled:cursor-not-allowed transition-colors">Anterior</button>
            <template x-for="p in getPageNumbers()" :key="p">
              <button @click="loadPage(p)" class="w-8 h-8 text-sm rounded-lg transition-colors"
                :class="p === pagination.page ? 'bg-primary-500 text-white' : 'hover:bg-[var(--color-surface-alt)]'"
                x-text="p"></button>
            </template>
            <button @click="loadPage(pagination.page + 1)" :disabled="!pagination.hasMore" class="px-3 py-1.5 text-sm rounded-lg hover:bg-[var(--color-surface-alt)] disabled:opacity-40 disabled:cursor-not-allowed transition-colors">Siguiente</button>
          </div>
        </div>
      </template>
    </div>
  </div>
</AdminLayout>

<script is:inline>
  window.reportesPage = function() {
    return {
      items: [],
      loading: false,
      exporting: false,
      pagination: { total: 0, page: 1, limit: 25, totalPages: 0, hasMore: false },
      stats: { total: 0, efectivas: 0, noEfectivas: 0, efectividad: 0 },
      filters: {
        fechaInicio: '',
        fechaFin: '',
        visitadorId: '',
        medicoId: '',
        especialidadId: '',
        efectiva: '',
      },

      visitadoresList: [],
      medicosList: [],
      especialidadesList: [],

      async init() {
        await Promise.all([
          this.loadVisitadores(),
          this.loadMedicos(),
          this.loadEspecialidades(),
        ]);
        await this.loadPage(1);
      },

      async loadVisitadores() {
        try {
          const r = await fetch('/api/visitadores?limit=200');
          const data = await r.json();
          this.visitadoresList = data.data || [];
        } catch (e) { this.visitadoresList = []; }
      },

      async loadMedicos() {
        try {
          const r = await fetch('/api/medicos?limit=200');
          const data = await r.json();
          this.medicosList = data.data || [];
        } catch (e) { this.medicosList = []; }
      },

      async loadEspecialidades() {
        try {
          const r = await fetch('/api/especialidades?limit=200');
          const data = await r.json();
          this.especialidadesList = data.data || [];
        } catch (e) { this.especialidadesList = []; }
      },

      async loadPage(page) {
        this.loading = true;
        try {
          const params = new URLSearchParams();
          params.set('page', String(page));
          params.set('limit', String(this.pagination.limit));
          if ((window._fechaInicio || this.filters.fechaInicio)) params.set('fechaInicio', (window._fechaInicio || this.filters.fechaInicio));
          if ((window._fechaFin || this.filters.fechaFin)) params.set('fechaFin', (window._fechaFin || this.filters.fechaFin));
          if (this.filters.visitadorId) params.set('visitadorId', this.filters.visitadorId);
          if (this.filters.medicoId) params.set('medicoId', this.filters.medicoId);
          if (this.filters.especialidadId) params.set('especialidadId', this.filters.especialidadId);
          if (this.filters.efectiva) params.set('efectiva', this.filters.efectiva);

          const r = await fetch(`/api/reportes?${params.toString()}`);
          const data = await r.json();
          if (r.ok) {
            this.items = data.data || [];
            this.pagination = data.pagination || { total: 0, page: 1, limit: 25, totalPages: 0, hasMore: false };
            this.stats = data.stats || { total: 0, efectivas: 0, noEfectivas: 0, efectividad: 0 };
          }
        } catch (e) {
          console.error('Load reportes error:', e);
        }
        this.loading = false;
      },

      async exportExcel() {
        this.exporting = true;
        try {
          const params = new URLSearchParams();
          if ((window._fechaInicio || this.filters.fechaInicio)) params.set('fechaInicio', (window._fechaInicio || this.filters.fechaInicio));
          if ((window._fechaFin || this.filters.fechaFin)) params.set('fechaFin', (window._fechaFin || this.filters.fechaFin));
          if (this.filters.visitadorId) params.set('visitadorId', this.filters.visitadorId);
          if (this.filters.medicoId) params.set('medicoId', this.filters.medicoId);
          if (this.filters.especialidadId) params.set('especialidadId', this.filters.especialidadId);
          if (this.filters.efectiva) params.set('efectiva', this.filters.efectiva);

          const r = await fetch(`/api/reportes/excel?${params.toString()}`);
          if (!r.ok) {
            const err = await r.json();
            window.showToast(err.error || 'Error al exportar', 'error');
            this.exporting = false;
            return;
          }
          const blob = await r.blob();
          const url = window.URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = `reporte-visitas-${new Date().toISOString().slice(0, 10)}.xlsx`;
          document.body.appendChild(a);
          a.click();
          a.remove();
          window.URL.revokeObjectURL(url);
          window.showToast('Reporte exportado correctamente', 'success');
        } catch (e) {
          window.showToast('Error al exportar reporte', 'error');
        }
        this.exporting = false;
      },

      clearFilters() {
        this.filters = {
          fechaInicio: '',
          fechaFin: '',
          visitadorId: '',
          medicoId: '',
          especialidadId: '',
          efectiva: '',
        };
        window._fechaInicio = '';
        window._fechaFin = '';
        var input = document.getElementById('dateRange');
        if (input) input.value = '';
        this.loadPage(1);
      },

      formatDate(date) {        if (!date) return '—';
        return new Date(date).toLocaleDateString('es-MX', {
          year: 'numeric', month: '2-digit', day: '2-digit',
        });
      },

      getPageNumbers() {
        const pages = [];
        const total = this.pagination.totalPages;
        const current = this.pagination.page;
        const start = Math.max(1, current - 2);
        const end = Math.min(total, current + 2);
        for (let i = start; i <= end; i++) pages.push(i);
        return pages;
      },
    };
  }
</script>

<script is:inline src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/moment@2.30.1/moment.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daterangepicker@3.1.0/daterangepicker.css" />
<script is:inline src="https://cdn.jsdelivr.net/npm/daterangepicker@3.1.0/daterangepicker.min.js"></script>
<script is:inline>
  function initDateRange() {
    var input = document.getElementById('dateRange');
    if (!input || typeof $ !== 'function' || typeof $(input).daterangepicker !== 'function') {
      setTimeout(initDateRange, 300);
      return;
    }
    $(input).daterangepicker({
      autoApply: true,
      showCustomRangeLabel: false,
      alwaysShowCalendars: true,
      opens: 'left',
      locale: {
        format: 'D MMM. YYYY',
        separator: ' - ',
        applyLabel: 'Aplicar',
        cancelLabel: 'Cancelar',
        fromLabel: 'Desde',
        toLabel: 'Hasta',
        customRangeLabel: 'Personalizado',
        weekLabel: 'S',
        daysOfWeek: ['Dom','Lun','Mar','Mie','Jue','Vie','Sab'],
        monthNames: ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'],
        firstDay: 1
      }
    }, function(start, end) {
      window._fechaInicio = start.format('YYYY-MM-DD');
      window._fechaFin = end.format('YYYY-MM-DD');
    });
  }
  setTimeout(initDateRange, 500);
</script>

<style is:global>
  .toast-enter { animation: toastIn 0.3s ease-out; }
  .toast-exit { animation: toastOut 0.3s ease-in forwards; }
  @keyframes toastIn { from { opacity: 0; transform: translateX(100%); } to { opacity: 1; transform: translateX(0); } }
  @keyframes toastOut { from { opacity: 1; transform: translateX(0); } to { opacity: 0; transform: translateX(100%); } }

  .daterangepicker { background-color: #1A1D24 !important; color: #E8E8E8 !important; border-color: #333 !important; border-radius: 12px !important; box-shadow: 0 8px 32px rgba(0,0,0,.5) !important; font-family: 'Inter',sans-serif !important; padding: 12px !important; }
  .daterangepicker:before, .daterangepicker:after { display: none !important; }
  .daterangepicker .calendar-table { background: transparent !important; border: none !important; }
  .daterangepicker .calendar-table th { color: #94a3b8 !important; }
  .daterangepicker .calendar-table th.month { color: #E8E8E8 !important; font-weight: 600 !important; }
  .daterangepicker .calendar-table .next span, .daterangepicker .calendar-table .prev span { border-color: #E8E8E8 !important; }
  .daterangepicker td { color: #E8E8E8 !important; border-radius: 8px !important; }
  .daterangepicker td.available:hover { background: #2A2D35 !important; }
  .daterangepicker td.in-range { background: rgba(37,99,235,.25) !important; }
  .daterangepicker td.start-date, .daterangepicker td.end-date, .daterangepicker td.active { background: #2563eb !important; color: #fff !important; }
  .daterangepicker td.off { color: #555 !important; background: transparent !important; }
  .daterangepicker .ranges li { color: #E8E8E8 !important; background: transparent !important; border: none !important; border-radius: 8px !important; }
  .daterangepicker .ranges li:hover { background: #2A2D35 !important; }
  .daterangepicker .ranges li.active { background: #2563eb !important; color: #fff !important; }
  .daterangepicker .drp-buttons { border-top-color: #333 !important; display: none !important; }
</style>
