---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { db } from '../../lib/db';
import { medicos, especialidades } from '../../lib/db/schema/index';
import { eq, and, isNull } from 'drizzle-orm';

const { id } = Astro.params;
const medicoId = Number(id);

const [medico] = await db
  .select({
    id: medicos.id,
    codigo: medicos.codigo,
    nombre: medicos.nombre,
    especialidadId: medicos.especialidadId,
    direccion: medicos.direccion,
    telefono: medicos.telefono,
    email: medicos.email,
    activo: medicos.activo,
    especialidad: { nombre: especialidades.nombre },
  })
  .from(medicos)
  .leftJoin(especialidades, eq(medicos.especialidadId, especialidades.id))
  .where(and(eq(medicos.id, medicoId), isNull(medicos.deletedAt)))
  .limit(1);
---

<AdminLayout>
  <div class="space-y-6" x-data="medicoDetalle()" x-init="init(Number($el.dataset.id))" data-id={medico?.id || 0}>
    <div class="flex items-center gap-3">
      <a href="/medicos" class="p-2 rounded-lg hover:bg-[var(--color-surface-alt)] transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 12H5m7 7l-7-7 7-7"/></svg>
      </a>
      <div>
        <h1 class="text-2xl font-bold">{medico?.nombre || 'Médico no encontrado'}</h1>
        <p class="text-sm text-[var(--color-text-muted)]">Gestión de productos asignados</p>
      </div>
    </div>

    <!-- Info del médico -->
    <div class="bg-[var(--color-surface)] rounded-xl border border-[var(--color-border)] p-5">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div>
          <p class="text-xs text-[var(--color-text-muted)] mb-0.5">Código</p>
          <p class="text-sm font-mono font-medium">{medico?.codigo || '—'}</p>
        </div>
        <div>
          <p class="text-xs text-[var(--color-text-muted)] mb-0.5">Especialidad</p>
          <p class="text-sm font-medium">{medico?.especialidad?.nombre || '—'}</p>
        </div>
        <div>
          <p class="text-xs text-[var(--color-text-muted)] mb-0.5">Teléfono</p>
          <p class="text-sm font-medium">{medico?.telefono || '—'}</p>
        </div>
        <div>
          <p class="text-xs text-[var(--color-text-muted)] mb-0.5">Email</p>
          <p class="text-sm font-medium">{medico?.email || '—'}</p>
        </div>
      </div>
    </div>

    <!-- Productos Asignados -->
    <div class="bg-[var(--color-surface)] rounded-xl border border-[var(--color-border)]">
      <div class="px-5 py-4 border-b border-[var(--color-border)] flex items-center justify-between">
        <h2 class="font-semibold">Productos Asignados <span class="text-sm text-[var(--color-text-muted)]" x-text="`(${asignados.length})`"></span></h2>
        <button @click="abrirModalDisponibles()" class="text-sm px-3 py-1.5 rounded-lg bg-primary-600 hover:bg-primary-700 text-white transition-colors inline-flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          Agregar productos
        </button>
      </div>

      <!-- Tabla de asignados -->
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="border-b border-[var(--color-border)] bg-[var(--color-surface-alt)]">
              <th class="text-left px-4 py-3 text-xs font-semibold text-[var(--color-text-muted)] uppercase w-14">Foto</th>
              <th class="text-left px-4 py-3 text-xs font-semibold text-[var(--color-text-muted)] uppercase">Código</th>
              <th class="text-left px-4 py-3 text-xs font-semibold text-[var(--color-text-muted)] uppercase">Producto</th>
              <th class="text-right px-4 py-3 text-xs font-semibold text-[var(--color-text-muted)] uppercase">Acción</th>
            </tr>
          </thead>
          <tbody>
            <template x-if="asignados.length === 0">
              <tr><td colspan="4" class="text-center py-8 text-sm text-[var(--color-text-muted)]">Sin productos asignados</td></tr>
            </template>
            <template x-for="p in asignados" :key="p.id">
              <tr class="border-b border-[var(--color-border)] hover:bg-[var(--color-surface-alt)] transition-colors">
                <td class="px-4 py-3">
                  <img x-show="p.imagenUrl" :src="p.imagenUrl" @click="verImagen(p.imagenUrl)" class="w-10 h-10 rounded-lg object-cover border border-[var(--color-border)] cursor-pointer hover:opacity-80 transition-opacity" alt="" />
                  <div x-show="!p.imagenUrl" class="w-10 h-10 rounded-lg bg-[var(--color-surface-alt)] border border-[var(--color-border)] flex items-center justify-center">
                    <svg class="w-5 h-5 text-[var(--color-text-muted)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                  </div>
                </td>
                <td class="px-4 py-3 text-sm font-mono" x-text="p.codigo"></td>
                <td class="px-4 py-3 text-sm font-medium" x-text="p.nombre"></td>
                <td class="px-4 py-3 text-right">
                  <button @click="quitar(p.id)" class="p-1.5 rounded-lg text-red-500 hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors" title="Quitar">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                  </button>
                </td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Modal Productos Disponibles -->
    <div x-show="showDisponibles" class="fixed inset-0 z-50 flex items-center justify-center p-4" x-transition>
      <div class="absolute inset-0 bg-black/50 modal-backdrop" @click="showDisponibles = false"></div>
      <div class="relative bg-[var(--color-surface)] rounded-xl border border-[var(--color-border)] shadow-xl w-full max-w-2xl max-h-[90vh] overflow-hidden modal-content" @click.stop>
        <div class="flex items-center justify-between px-5 py-4 border-b border-[var(--color-border)]">
          <h2 class="font-semibold">Productos Disponibles</h2>
          <button @click="showDisponibles = false" class="p-1 rounded-lg hover:bg-[var(--color-surface-alt)] transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
        <div class="px-5 py-3 border-b border-[var(--color-border)]">
          <div class="relative">
            <svg class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-[var(--color-text-muted)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            <input type="text" x-model="buscarDisponible" @input="paginaDisponibles = 1" placeholder="Buscar producto..." class="w-full pl-10 pr-4 py-2 border border-[var(--color-border)] rounded-xl bg-[var(--color-surface)] text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500" />
          </div>
        </div>
        <div class="overflow-y-auto max-h-[50vh]">
          <table class="w-full">
            <thead>
              <tr class="border-b border-[var(--color-border)] bg-[var(--color-surface-alt)] sticky top-0">
                <th class="text-left px-4 py-3 text-xs font-semibold text-[var(--color-text-muted)] uppercase w-14">Foto</th>
                <th class="text-left px-4 py-3 text-xs font-semibold text-[var(--color-text-muted)] uppercase">Código</th>
                <th class="text-left px-4 py-3 text-xs font-semibold text-[var(--color-text-muted)] uppercase">Producto</th>
                <th class="text-right px-4 py-3 text-xs font-semibold text-[var(--color-text-muted)] uppercase w-24">Acción</th>
              </tr>
            </thead>
            <tbody>
              <template x-if="productosFiltrados.length === 0">
                <tr><td colspan="4" class="text-center py-12 text-sm text-[var(--color-text-muted)]">No se encontraron productos</td></tr>
              </template>
              <template x-for="p in productosPaginados" :key="p.id">
                <tr class="border-b border-[var(--color-border)] hover:bg-[var(--color-surface-alt)] transition-colors">
                  <td class="px-4 py-3">
                    <img x-show="p.imagenUrl" :src="p.imagenUrl" @click="verImagen(p.imagenUrl)" class="w-10 h-10 rounded-lg object-cover border border-[var(--color-border)] cursor-pointer" alt="" />
                    <div x-show="!p.imagenUrl" class="w-10 h-10 rounded-lg bg-[var(--color-surface-alt)] border border-[var(--color-border)] flex items-center justify-center">
                      <svg class="w-5 h-5 text-[var(--color-text-muted)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                    </div>
                  </td>
                  <td class="px-4 py-3 text-sm font-mono" x-text="p.codigo"></td>
                  <td class="px-4 py-3 text-sm font-medium" x-text="p.nombre"></td>
                  <td class="px-4 py-3 text-right">
                    <button @click="asignar(p.id)" class="px-3 py-1.5 rounded-lg text-xs font-medium bg-primary-600 hover:bg-primary-700 text-white transition-colors">Asignar</button>
                  </td>
                </tr>
              </template>
            </tbody>
          </table>
        </div>
        <div class="flex items-center justify-between px-5 py-3 border-t border-[var(--color-border)] bg-[var(--color-surface-alt)]">
          <span class="text-xs text-[var(--color-text-muted)]" x-text="`${productosFiltrados.length} resultado(s)`"></span>
          <div class="flex items-center gap-2">
            <button @click="paginaDisponibles > 1 && paginaDisponibles--" :disabled="paginaDisponibles <= 1" class="p-1.5 rounded-lg hover:bg-[var(--color-surface)] disabled:opacity-40 disabled:cursor-not-allowed transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            </button>
            <span class="text-xs text-[var(--color-text-muted)]" x-text="`${paginaDisponibles} / ${totalPaginas}`"></span>
            <button @click="paginaDisponibles < totalPaginas && paginaDisponibles++" :disabled="paginaDisponibles >= totalPaginas" class="p-1.5 rounded-lg hover:bg-[var(--color-surface)] disabled:opacity-40 disabled:cursor-not-allowed transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Lightbox -->
    <div x-show="lightboxUrl" class="fixed inset-0 z-[9999] flex items-center justify-center bg-black/80" @click="lightboxUrl = null" @keydown.escape.window="lightboxUrl = null">
      <div class="relative max-w-3xl max-h-[90vh] mx-4">
        <button @click="lightboxUrl = null" class="absolute -top-10 right-0 text-white hover:text-gray-300 transition-colors">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
        <img :src="lightboxUrl" class="max-w-full max-h-[85vh] rounded-xl shadow-2xl" alt="" />
      </div>
    </div>
  </div>
</AdminLayout>

<script is:inline>
  window.medicoDetalle = function() {
    return {
      medicoId: 0,
      asignados: [],
      disponibles: [],
      showDisponibles: false,
      lightboxUrl: null,
      buscarDisponible: '',
      paginaDisponibles: 1,
      limitePagina: 15,

      get productosFiltrados() {
        if (!this.buscarDisponible) return this.disponibles;
        var q = this.buscarDisponible.toLowerCase();
        return this.disponibles.filter(function(p) { return p.nombre.toLowerCase().includes(q) || p.codigo.toLowerCase().includes(q); });
      },

      get totalPaginas() {
        return Math.max(1, Math.ceil(this.productosFiltrados.length / this.limitePagina));
      },

      get productosPaginados() {
        var start = (this.paginaDisponibles - 1) * this.limitePagina;
        return this.productosFiltrados.slice(start, start + this.limitePagina);
      },

      init(id) {
        this.medicoId = id;
        this.load();
      },

      abrirModalDisponibles() {
        this.showDisponibles = true;
      },

      verImagen(url) {
        this.lightboxUrl = url;
      },

      async load() {
        try {
          var r = await fetch('/api/medicos/productos/' + this.medicoId);
          var data = await r.json();
          this.asignados = data.asignados || [];
          this.disponibles = data.disponibles || [];
        } catch(e) {
          window.showToast('Error al cargar productos', 'error');
        }
      },

      async asignar(id) {
        try {
          var r = await fetch('/api/medicos/productos/' + this.medicoId, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ productoIds: this.asignados.map(p => p.id).concat([id]) }),
          });
          if (!r.ok) throw new Error();
          window.showToast('Producto asignado');
          this.load();
        } catch(e) {
          window.showToast('Error al asignar', 'error');
        }
      },

      async quitar(id) {
        try {
          var r = await fetch('/api/medicos/productos/' + this.medicoId, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ productoIds: this.asignados.filter(p => p.id !== id).map(p => p.id) }),
          });
          if (!r.ok) throw new Error();
          window.showToast('Producto removido');
          this.load();
        } catch(e) {
          window.showToast('Error al remover', 'error');
        }
      },
    };
  };
</script>
