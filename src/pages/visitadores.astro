---
import AdminLayout from '../layouts/AdminLayout.astro';
---

<AdminLayout>
  <div class="space-y-6" x-data="visitadoresPage()" x-init="load()">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold">Visitadores</h1>
        <p class="text-[var(--color-text-muted)] text-sm mt-0.5">Gestion de visitadores medicos</p>
      </div>
      <button
        @click="openModal()"
        class="bg-primary-600 hover:bg-primary-700 text-white px-4 py-2.5 rounded-xl text-sm font-medium transition-colors flex items-center gap-2"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        Nuevo Visitador
      </button>
    </div>

    <div class="flex flex-col sm:flex-row gap-3">
      <div class="relative flex-1">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-[var(--color-text-muted)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        <input
          type="text"
          x-model="searchQuery"
          @input.debounce.300ms="debounceSearch()"
          placeholder="Buscar por codigo, nombre o email..."
          class="border border-[var(--color-border)] rounded-xl px-4 py-2.5 bg-[var(--color-surface)] pl-10 w-full"
        />
      </div>
      <select
        x-model="filterActivo"
        @change="load()"
        class="border border-[var(--color-border)] rounded-xl px-4 py-2.5 bg-[var(--color-surface)] text-sm"
      >
        <option value="">Todos los estados</option>
        <option value="1">Activos</option>
        <option value="0">Inactivos</option>
      </select>
    </div>

    <div class="bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-[var(--color-border)] bg-[var(--color-surface-alt)]">
              <th class="text-left px-4 py-3 font-medium text-[var(--color-text-muted)]">Codigo</th>
              <th class="text-left px-4 py-3 font-medium text-[var(--color-text-muted)]">Nombre</th>
              <th class="text-left px-4 py-3 font-medium text-[var(--color-text-muted)]">Email</th>
              <th class="text-left px-4 py-3 font-medium text-[var(--color-text-muted)]">Telefono</th>
              <th class="text-left px-4 py-3 font-medium text-[var(--color-text-muted)]">Usuario</th>
              <th class="text-left px-4 py-3 font-medium text-[var(--color-text-muted)]">Estado</th>
              <th class="text-right px-4 py-3 font-medium text-[var(--color-text-muted)]">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <template x-if="loading">
              <tr>
                <td colspan="7" class="text-center py-12 text-[var(--color-text-muted)]">
                  <div class="flex items-center justify-center gap-2">
                    <svg class="animate-spin w-5 h-5" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
                    Cargando...
                  </div>
                </td>
              </tr>
            </template>
            <template x-if="!loading && items.length === 0">
              <tr>
                <td colspan="7" class="text-center py-12 text-[var(--color-text-muted)]">No se encontraron visitadores</td>
              </tr>
            </template>
            <template x-for="item in items" :key="item.id">
              <tr class="border-b border-[var(--color-border)] hover:bg-[var(--color-surface-alt)] transition-colors">
                <td class="px-4 py-3 font-mono text-xs" x-text="item.codigo"></td>
                <td class="px-4 py-3 font-medium" x-text="item.nombre"></td>
                <td class="px-4 py-3 text-[var(--color-text-muted)]" x-text="item.email || '—'"></td>
                <td class="px-4 py-3 text-[var(--color-text-muted)]" x-text="item.telefono || '—'"></td>
                <td class="px-4 py-3 text-[var(--color-text-muted)]">
                  <span x-show="item.usuario?.username" x-text="item.usuario?.username"></span>
                  <span x-show="!item.usuario?.username" class="text-[var(--color-text-muted)]">—</span>
                </td>
                <td class="px-4 py-3">
                  <span
                    class="inline-flex px-2 py-0.5 rounded-full text-xs font-medium"
                    :class="item.activo === '1' ? 'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400' : 'bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400'"
                    x-text="item.activo === '1' ? 'Activo' : 'Inactivo'"
                  ></span>
                </td>
                <td class="px-4 py-3">
                  <div class="flex items-center justify-end gap-1">
                    <button @click="openModal(item)" class="p-2 rounded-lg hover:bg-[var(--color-surface-alt)] transition-colors" title="Editar">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                    </button>
                    <button @click="deleteItem(item.id)" class="p-2 rounded-lg hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors text-red-500" title="Eliminar">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                    </button>
                  </div>
                </td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>

      <div class="flex items-center justify-between px-4 py-3 border-t border-[var(--color-border)]">
        <span class="text-sm text-[var(--color-text-muted)]" x-text="`Mostrando ${items.length} de ${pagination.total} registros`"></span>
        <div class="flex items-center gap-1">
          <button
            @click="changePage(pagination.page - 1)"
            :disabled="pagination.page <= 1"
            class="px-3 py-1.5 rounded-lg text-sm border border-[var(--color-border)] hover:bg-[var(--color-surface-alt)] transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
          >Anterior</button>
          <span class="px-3 py-1.5 text-sm text-[var(--color-text-muted)]" x-text="`Pagina ${pagination.page} de ${pagination.totalPages}`"></span>
          <button
            @click="changePage(pagination.page + 1)"
            :disabled="!pagination.hasMore"
            class="px-3 py-1.5 rounded-lg text-sm border border-[var(--color-border)] hover:bg-[var(--color-surface-alt)] transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
          >Siguiente</button>
        </div>
      </div>
    </div>

    <!-- Modal -->
    <div x-show="showModal" class="fixed inset-0 z-50 flex items-center justify-center p-4" x-transition>
      <div class="absolute inset-0 bg-black/50 modal-backdrop" @click="closeModal()"></div>
      <div class="relative bg-[var(--color-surface)] rounded-xl border border-[var(--color-border)] shadow-xl w-full max-w-lg max-h-[90vh] overflow-y-auto modal-content" @click.stop>
        <div class="flex items-center justify-between px-6 py-4 border-b border-[var(--color-border)]">
          <h2 class="text-lg font-semibold" x-text="editingId ? 'Editar Visitador' : 'Nuevo Visitador'"></h2>
          <button @click="closeModal()" class="p-1 rounded-lg hover:bg-[var(--color-surface-alt)] transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
        <form @submit.prevent="save()" class="p-6 space-y-4">
          <div>
            <label class="block text-sm font-medium mb-1.5">Codigo</label>
            <input
              type="text"
              x-model="formData.codigo"
              placeholder="Auto-generado si se deja vacio"
              class="border border-[var(--color-border)] rounded-xl px-4 py-2.5 bg-[var(--color-surface)] w-full"
            />
          </div>
          <div>
            <label class="block text-sm font-medium mb-1.5">Nombre <span class="text-red-500">*</span></label>
            <input
              type="text"
              x-model="formData.nombre"
              required
              class="border border-[var(--color-border)] rounded-xl px-4 py-2.5 bg-[var(--color-surface)] w-full"
            />
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium mb-1.5">Email</label>
              <input
                type="email"
                x-model="formData.email"
                class="border border-[var(--color-border)] rounded-xl px-4 py-2.5 bg-[var(--color-surface)] w-full"
              />
            </div>
            <div>
              <label class="block text-sm font-medium mb-1.5">Telefono</label>
              <input
                type="text"
                x-model="formData.telefono"
                class="border border-[var(--color-border)] rounded-xl px-4 py-2.5 bg-[var(--color-surface)] w-full"
              />
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium mb-1.5">Estado</label>
            <select x-model="formData.activo" class="border border-[var(--color-border)] rounded-xl px-4 py-2.5 bg-[var(--color-surface)] w-full">
              <option value="1">Activo</option>
              <option value="0">Inactivo</option>
            </select>
          </div>
          <div class="flex justify-end gap-3 pt-2">
            <button type="button" @click="closeModal()" class="px-4 py-2.5 rounded-xl text-sm border border-[var(--color-border)] hover:bg-[var(--color-surface-alt)] transition-colors">Cancelar</button>
            <button type="submit" class="bg-primary-600 hover:bg-primary-700 text-white px-4 py-2.5 rounded-xl text-sm font-medium transition-colors" x-text="editingId ? 'Actualizar' : 'Crear'"></button>
          </div>
        </form>
      </div>
    </div>
  </div>
</AdminLayout>

<script is:inline>
  window.visitadoresPage = function() {
    return {
      items: [],
      pagination: { total: 0, page: 1, limit: 25, totalPages: 0, hasMore: false },
      loading: true,
      searchQuery: '',
      searchTimer: null,
      filterActivo: '',

      showModal: false,
      editingId: null,
      formData: {
        codigo: '',
        nombre: '',
        email: '',
        telefono: '',
        activo: '1',
      },

      async load() {
        this.loading = true;
        try {
          const params = new URLSearchParams({
            page: String(this.pagination.page),
            limit: String(this.pagination.limit),
            search: this.searchQuery,
          });
          if (this.filterActivo) params.set('activo', this.filterActivo);

          const r = await fetch(`/api/visitadores?${params.toString()}`);
          const data = await r.json();
          this.items = data.data || [];
          this.pagination = data.pagination || { total: 0, page: 1, limit: 25, totalPages: 0, hasMore: false };
        } catch (e) {
          window.showToast('Error al cargar visitadores', 'error');
        }
        this.loading = false;
      },

      debounceSearch() {
        clearTimeout(this.searchTimer);
        this.searchTimer = setTimeout(() => { this.pagination.page = 1; this.load(); }, 300);
      },

      changePage(page) {
        if (page < 1 || page > this.pagination.totalPages) return;
        this.pagination.page = page;
        this.load();
      },

      openModal(item = null) {
        if (item) {
          this.editingId = item.id;
          this.formData = {
            codigo: item.codigo || '',
            nombre: item.nombre || '',
            email: item.email || '',
            telefono: item.telefono || '',
            activo: item.activo || '1',
            };
        } else {
          this.editingId = null;
          this.formData = { codigo: '', nombre: '', email: '', telefono: '', activo: '1' };
        }
        this.showModal = true;
      },

      closeModal() {
        this.showModal = false;
        this.editingId = null;
        this.formData = { codigo: '', nombre: '', email: '', telefono: '', activo: '1' };
      },

      async save() {
        try {
          const url = this.editingId ? `/api/visitadores/${this.editingId}` : '/api/visitadores';
          const method = this.editingId ? 'PUT' : 'POST';
          const r = await fetch(url, {
            method,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(this.formData),
          });
          if (!r.ok) {
            const err = await r.json();
            throw new Error(err.error || 'Error al guardar');
          }
          const result = await r.json();
          if (result.userCreated) {
            window.showToast('Visitador y cuenta de usuario creados exitosamente');
          } else {
            window.showToast(this.editingId ? 'Visitador actualizado exitosamente' : 'Visitador creado exitosamente');
          }
          this.closeModal();
          this.load();
        } catch (e) {
          window.showToast(e.message, 'error');
        }
      },

      async deleteItem(id) {
        if (!confirm('Estas seguro de eliminar este visitador?')) return;
        try {
          const r = await fetch(`/api/visitadores/${id}`, { method: 'DELETE' });
          if (!r.ok) throw new Error('Error al eliminar');
          window.showToast('Visitador eliminado exitosamente');
          this.load();
        } catch (e) {
          window.showToast(e.message, 'error');
        }
      },
    };
  }
</script>
