    "unstorage": "^1.17.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.0",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.19.19",
    "drizzle-kit": "0.30.6",
    "tailwindcss": "4.3.0",
