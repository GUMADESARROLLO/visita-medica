    "db:studio": "drizzle-kit studio --config drizzle.config.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/node": "^9.1.0",
    "astro": "^5.5.0",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.4.8",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.0",
    "exceljs": "^4.4.0",
    "jose": "^5.10.0",
    "mysql2": "^3.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.0",
    "drizzle-kit": "^0.30.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
